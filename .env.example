# Optional. The app runs with no environment variables; all data is UI mock data.
# "enabled" swaps the support ticket form for a third-party widget (not wired yet).
NEXT_PUBLIC_SUPPORT_WIDGET=disabled

# ── Shared Netsach backend (account pages: settings, team, plans, White Label, admin) ──
# Unset = demo mode: an in-browser demo API answers and the sign-in is faked.
NEXT_PUBLIC_API_BASE_URL=
# Rankoya's own host, used to tell it apart from White Label tenant domains.
NEXT_PUBLIC_APP_HOST=app.rankoya.uk

# ── White Label domains (server only; the Vercel project that serves Rankoya) ──
# Unset together with NEXT_PUBLIC_API_BASE_URL = Vercel is simulated.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ── Paddle checkout ──
# Client-side token from Paddle → Developer tools → Authentication (sandbox token for local).
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# "sandbox" or "production".
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox

# Funnel offers (docs/Rankoya_Funnel_Credit_Specification.pdf). Every offer is a
# ONE-TIME price (no renewals), so create each as a non-recurring price in Paddle
# and paste its price ID (pri_…) here. Credits are granted by the backend webhook.
# Front End plan 1: Rankoya Core, $27, 250 credits, 1 site
NEXT_PUBLIC_PADDLE_CORE=
# Front End plan 2: Rankoya Commercial, $97, 900 credits, 10 sites, commercial licence
NEXT_PUBLIC_PADDLE_COMMERCIAL=
# OTO1: Autopilot Agent, $67, +620 credits (spec price test: $47 as a second price on the same product)
NEXT_PUBLIC_PADDLE_AUTOPILOT=
# OTO2: Whitelabel, $297, 2,750 shared pool credits, 100 client accounts
NEXT_PUBLIC_PADDLE_WHITELABEL=
# Bundle: Commercial + Autopilot + Whitelabel Lite (25 clients), $297, 2,750 credits
NEXT_PUBLIC_PADDLE_BUNDLE=
# Mega Bundle: Bundle buyers only, $127, +1,500 credits
NEXT_PUBLIC_PADDLE_MEGA_BUNDLE=

# Credit packs
# S: $27, +500 credits (order bump on the Front End)
NEXT_PUBLIC_PADDLE_CREDIT_PACK_S=
# M: $67, +1,500 credits (downsell / in-app after a declined upsell)
NEXT_PUBLIC_PADDLE_CREDIT_PACK_M=
# L: $127, +3,000 credits (add-on on the Bundle order form)
NEXT_PUBLIC_PADDLE_CREDIT_PACK_L=
# XL: $197, +5,000 credits (add-on on the Whitelabel order form)
NEXT_PUBLIC_PADDLE_CREDIT_PACK_XL=
# In-app pack, no affiliate commission: 1,000 credits at $20–30 (spec section 8)
NEXT_PUBLIC_PADDLE_CREDIT_PACK_IN_APP=

# Legacy: still read by the current /upgrade page, not part of the funnel spec.
# Leave empty; don't create these in Paddle. Remove once /upgrade moves to the funnel offers.
NEXT_PUBLIC_PADDLE_PROFESSIONAL_PLAN_MONTHLY=
NEXT_PUBLIC_PADDLE_PROFESSIONAL_PLAN_ANNUALLY=
NEXT_PUBLIC_PADDLE_AGENCY_PLAN_MONTHLY=
NEXT_PUBLIC_PADDLE_AGENCY_PLAN_ANNUALLY=
NEXT_PUBLIC_PADDLE_RESELLER_PLAN_MONTHLY=
NEXT_PUBLIC_PADDLE_RESELLER_PLAN_ANNUALLY=
NEXT_PUBLIC_PADDLE_REMOVE_BRANDING_LIFETIME=
NEXT_PUBLIC_PADDLE_WHITELABEL_STARTER=
NEXT_PUBLIC_PADDLE_WHITELABEL_PRO=
NEXT_PUBLIC_PADDLE_WHITELABEL_UNLIMITED=

# ── Integrations: OAuth and credential flows (server only, never NEXT_PUBLIC_) ──
# docs/Rankoya integrations OAuth and credential flows guide.pdf. Route handlers
# live under src/app/api/integrations/*.
# Public URL the providers redirect back to. Unset = the request's own origin
# (fine on localhost and Vercel previews; Wix needs HTTPS for its callback).
APP_URL=
# Signs the short-lived OAuth state cookie. 32+ random characters:
#   openssl rand -base64 32
INTEGRATIONS_STATE_SECRET=
# Laravel base URL including /api, as reached from the Next server.
# Unset = NEXT_PUBLIC_API_BASE_URL.
BACKEND_INTERNAL_URL=

# Wix: Rankoya's self-managed Wix app (dev.wix.com → your app → Develop → OAuth).
# Laravel needs the same App ID and secret to mint tokens when it publishes.
WIX_APP_ID=
WIX_APP_SECRET=
# Only while the app is unlisted: the GUID behind the app's share install link.
WIX_SHARE_URL_ID=

# Make, Lovable, Replit (webhooks): nothing here. Each connection gets its own
# signing secret (whsec_…), sent as X-Rankoya-Signature. Test sends go through
# /api/integrations/webhook/test.

# RSS / JSON feed (/api/feeds/<token>):
# Signs feed links. 32+ random characters; unset = INTEGRATIONS_STATE_SECRET.
# Changing it replaces every site's feed link at once.
FEED_TOKEN_SECRET=
# Sanctum token of a Rankoya service user that can read every site's published
# articles. Issued by the backend team. Feeds return 503 until it's set.
BACKEND_SERVICE_TOKEN=

# Duda (hidden from the catalog: its API needs a paid plan). Nothing here when
# it comes back: each customer enters their own Duda API credentials.
