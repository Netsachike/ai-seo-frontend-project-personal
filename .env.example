# Optional. The app runs with no environment variables; all data is UI mock data.
# "enabled" swaps the support ticket form for a third-party widget (not wired yet).
NEXT_PUBLIC_SUPPORT_WIDGET=disabled

# ── Shared Netsach backend (account pages: settings, team, plans, White Label, admin) ──
# Unset = demo mode: an in-browser demo API answers and the sign-in is faked.
NEXT_PUBLIC_API_BASE_URL=
# Orbit's own host, used to tell it apart from White Label tenant domains.
NEXT_PUBLIC_APP_HOST=

# ── White Label domains (server only; the Vercel project that serves Orbit) ──
# Unset together with NEXT_PUBLIC_API_BASE_URL = Vercel is simulated.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ── Paddle checkout ──
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_PROFESSIONAL_PLAN_MONTHLY=
NEXT_PUBLIC_PADDLE_PROFESSIONAL_PLAN_ANNUALLY=
NEXT_PUBLIC_PADDLE_AGENCY_PLAN_MONTHLY=
NEXT_PUBLIC_PADDLE_AGENCY_PLAN_ANNUALLY=
NEXT_PUBLIC_PADDLE_RESELLER_PLAN_MONTHLY=
NEXT_PUBLIC_PADDLE_RESELLER_PLAN_ANNUALLY=
NEXT_PUBLIC_PADDLE_REMOVE_BRANDING_LIFETIME=
NEXT_PUBLIC_PADDLE_WHITELABEL_STARTER=
NEXT_PUBLIC_PADDLE_WHITELABEL_PRO=
NEXT_PUBLIC_PADDLE_WHITELABEL_UNLIMITED=
